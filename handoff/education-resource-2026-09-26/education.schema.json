{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metabolomics Navigator education resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "summary", "url", "format", "tool_slugs", "provider", "provenance", "status"],
  "properties": {
    "$schema": {"type": "string"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 20},
    "url": {"type": "string", "format": "uri"},
    "video_id": {"type": "string"},
    "format": {
      "enum": ["workshop_recording", "video_tutorial", "software_walkthrough", "lecture_demo"]
    },
    "tool_slugs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "provider": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "type": {"enum": ["developer", "workshop", "training_program", "community", "other"]}
      }
    },
    "workshop": {"type": "string"},
    "publication_date": {"type": "string", "format": "date"},
    "duration_minutes": {"type": "integer", "minimum": 1},
    "experience_level": {
      "enum": ["introductory", "intermediate", "advanced", "mixed", "unspecified"]
    },
    "language": {"type": "string", "default": "en"},
    "presenters": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "topics": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "notes": {"type": "string"},
    "provenance": {
      "type": "object",
      "required": ["submitted_by"],
      "additionalProperties": false,
      "properties": {
        "submitted_by": {"enum": ["curator", "developer", "maintainer", "user", "other"]},
        "source": {"type": "string"},
        "verified_against": {"type": "string"},
        "last_checked": {"type": "string", "format": "date"}
      }
    },
    "status": {
      "type": "object",
      "required": ["entry"],
      "additionalProperties": false,
      "properties": {
        "entry": {"enum": ["draft", "published", "archived"]},
        "created_at": {"type": "string", "format": "date"},
        "updated_at": {"type": "string", "format": "date"}
      }
    }
  }
}

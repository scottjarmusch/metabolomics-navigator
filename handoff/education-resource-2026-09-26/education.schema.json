{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metabolomics Navigator education resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "summary", "url", "resource_type", "tool_slugs", "provider", "status"],
  "properties": {
    "$schema": {"type": "string"},
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "resource_type": {
      "enum": ["video", "workshop", "tutorial", "documentation", "training_hub"]
    },
    "tool_slugs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "provider": {
      "type": "string",
      "minLength": 2
    },
    "experience_level": {
      "enum": ["introductory", "intermediate", "advanced", "mixed", "unspecified"]
    },
    "note": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submitted_by": {
          "enum": ["curator", "developer", "maintainer", "user", "other"]
        },
        "last_checked": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "status": {
      "type": "object",
      "required": ["entry"],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "enum": ["draft", "published", "archived"]
        }
      }
    }
  }
}
